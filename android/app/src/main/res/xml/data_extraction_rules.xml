<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) 的备份/迁移规则。
     allowBackup="false" 只管云备份，D2D 设备迁移走的是这份规则，
     所以两边都要显式排除，否则换机时凭据依旧会被搬过去。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
